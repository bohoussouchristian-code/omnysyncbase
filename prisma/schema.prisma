generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  GERANT
  CAISSIER
  MAGASINIER
}

enum WarehouseType {
  ENTREPOT
  BOUTIQUE
}

enum MovementType {
  ENTREE
  SORTIE
  TRANSFERT_ENTREE
  TRANSFERT_SORTIE
  AJUSTEMENT
  VENTE
  ACHAT
  RETOUR_VENTE
  RETOUR_ACHAT
}

enum PurchaseStatus {
  EN_ATTENTE
  RECUE
  ANNULEE
}

enum SaleStatus {
  EN_ATTENTE
  PAYEE
  PARTIELLE
  CREDIT
  ANNULEE
}

enum PaymentMethod {
  ESPECES
  MOBILE_MONEY
  VIREMENT
  CREDIT
  MIXTE
}

enum PaymentType {
  VENTE
  ACHAT
  DETTE_CLIENT
  DETTE_FOURNISSEUR
}

enum CustomerType {
  PARTICULIER
  PROFESSIONNEL
  REVENDEUR
}

// Une entreprise cliente de la plateforme. Toutes les données métier
// (produits, ventes, stock...) appartiennent à une Company et ne sont
// jamais visibles depuis une autre.
model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  // Informations affichées sur les documents officiels (reçus, factures...).
  director  String?
  headerText String?
  logoUrl   String?  @db.Text
  phone     String?
  email     String?
  address   String?

  users          User[]
  warehouses     Warehouse[]
  categories     Category[]
  units          Unit[]
  products       Product[]
  stocks         Stock[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  purchases      Purchase[]
  purchaseItems  PurchaseItem[]
  customers      Customer[]
  sales          Sale[]
  saleItems      SaleItem[]
  payments       Payment[]
  expenses       Expense[]
  cashSessions   CashSession[]
  services       Service[]
  proformas      Proforma[]
  proformaItems  ProformaItem[]
  loginLogs      LoginLog[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(CAISSIER)
  active         Boolean  @default(true)
  // Propriétaire de la plateforme : peut créer des entreprises depuis /console.
  // N'appartient à aucune entreprise (companyId reste vide pour ce compte).
  isPlatformOwner Boolean @default(false)
  createdAt      DateTime @default(now())

  // Protection contre le brute-force : compteur d'échecs consécutifs et
  // horodatage jusqu'auquel la connexion est bloquée après trop de tentatives.
  failedLoginAttempts Int       @default(0)
  lockedUntil          DateTime?

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  sales             Sale[]
  validatedSales    Sale[]          @relation("SaleValidatedBy")
  cancelledSales    Sale[]          @relation("SaleCancelledBy")
  purchases         Purchase[]
  receivedPurchases Purchase[]      @relation("PurchaseReceivedBy")
  validatedPurchases Purchase[]     @relation("PurchaseValidatedBy")
  stockMovements    StockMovement[]
  expenses          Expense[]
  cashSessions      CashSession[]
  payments          Payment[]
  proformas         Proforma[]
  loginLogs         LoginLog[]
}

// Trace de chaque connexion réussie : consultable par un administrateur pour
// savoir qui s'est connecté, quand et depuis quel appareil. Ne journalise que
// les connexions réussies (les échecs sont déjà comptabilisés sur le compte
// via failedLoginAttempts, pas d'intérêt à dupliquer un historique complet).
model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

model Warehouse {
  id      String        @id @default(cuid())
  name    String
  address String?
  type    WarehouseType @default(BOUTIQUE)
  active  Boolean       @default(true)
  // Dépôt central où arrivent toutes les commandes fournisseur (bon de livraison) ;
  // les boutiques sont ensuite servies depuis ce dépôt via un transfert de stock.
  // Un seul par entreprise (contrainte d'unicité partielle, voir migration).
  isGeneral Boolean     @default(false)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  stocks         Stock[]
  movements      StockMovement[]
  sales          Sale[]
  purchases      Purchase[]
  expenses       Expense[]
  cashSessions   CashSession[]

  createdAt DateTime @default(now())
}

model Category {
  id   String @id @default(cuid())
  name String

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  products Product[]
  services Service[]

  @@unique([companyId, name])
}

model Unit {
  id     String @id @default(cuid())
  name   String
  symbol String

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  products     Product[]
  packProducts Product[] @relation("PackUnit")

  @@unique([companyId, name])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  barcode       String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  // Prix optionnels selon le type de client (grille tarifaire pro/revendeur).
  // Si non renseignés, `salePrice` s'applique à tous.
  proPrice       Float?
  wholesalePrice Float?
  reorderLevel  Float    @default(0)
  imageUrl      String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  // Vente/achat par lot (carton, casier...) en plus de l'unité de base.
  // Le stock reste toujours compté dans l'unité de base (`unit`).
  piecesPerPack     Float   @default(1)
  packUnitId        String?
  packUnit          Unit?   @relation("PackUnit", fields: [packUnitId], references: [id])
  packPurchasePrice Float?
  packSalePrice     Float?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  stocks         Stock[]
  movements      StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  proformaItems  ProformaItem[]

  @@unique([companyId, barcode])
}

// Prestation de service (coupe de cheveux, lavage auto...) : pas de stock,
// pas d'unité, vendue au clic en caisse comme un produit.
model Service {
  id          String   @id @default(cuid())
  name        String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  durationMin Int?
  price       Float    @default(0)
  proPrice    Float?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  saleItems     SaleItem[]
  proformaItems ProformaItem[]
}

model Stock {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  quantity    Float     @default(0)

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  @@unique([productId, warehouseId])
}

model StockMovement {
  id                 String       @id @default(cuid())
  productId          String
  product            Product      @relation(fields: [productId], references: [id])
  warehouseId        String
  warehouse          Warehouse    @relation(fields: [warehouseId], references: [id])
  type               MovementType
  quantity           Float
  reason             String?
  reference          String?
  relatedWarehouseId String?
  userId             String?
  user               User?        @relation(fields: [userId], references: [id])
  createdAt          DateTime     @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  address   String?
  balance   Float    @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  purchases Purchase[]
  payments  Payment[]
}

model Purchase {
  id          String         @id @default(cuid())
  number      String
  supplierId  String
  supplier    Supplier       @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  date        DateTime       @default(now())
  status      PurchaseStatus @default(EN_ATTENTE)
  totalAmount Float          @default(0)
  paidAmount  Float          @default(0)
  notes       String?

  // Trace du bon de livraison : quand la marchandise commandée est effectivement
  // arrivée au dépôt général, et qui l'a réceptionnée (distinct de la date/l'auteur de la commande).
  receivedAt   DateTime?
  receivedById String?
  receivedBy   User?     @relation("PurchaseReceivedBy", fields: [receivedById], references: [id])

  // Tant qu'une commande n'est pas validée, c'est un brouillon librement
  // modifiable et sans effet sur la dette fournisseur. La validation fige
  // définitivement le contenu (fournisseur, articles, montants) et ne peut
  // être faite qu'une fois — c'est à ce moment que le paiement et le solde
  // fournisseur sont réellement enregistrés.
  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?     @relation("PurchaseValidatedBy", fields: [validatedById], references: [id])

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  items    PurchaseItem[]
  payments Payment[]

  @@unique([companyId, number])
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Float
  unitPrice  Float

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Customer {
  id            String       @id @default(cuid())
  name          String
  phone         String?
  address       String?
  type          CustomerType @default(PARTICULIER)
  creditBalance Float        @default(0)
  creditLimit   Float        @default(0)
  loyaltyPoints Float        @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  sales     Sale[]
  payments  Payment[]
  proformas Proforma[]
}

// Devis non contractuel remis à un client avant une vente (pour financement,
// validation interne...) : mêmes lignes qu'une vente mais aucun effet sur le
// stock, aucun encaissement — un document informatif, convertible plus tard
// en vraie vente si le client accepte.
model Proforma {
  id          String    @id @default(cuid())
  number      String
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  // Client ponctuel non enregistré (nom/téléphone libres) si aucun compte client.
  clientName  String?
  clientPhone String?
  validUntil  DateTime?
  totalAmount Float     @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  items ProformaItem[]

  @@unique([companyId, number])
}

model ProformaItem {
  id         String   @id @default(cuid())
  proformaId String
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  quantity   Float
  unitPrice  Float
  subtotal   Float

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Sale {
  id          String        @id @default(cuid())
  number      String
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  userId      String?
  user        User?         @relation(fields: [userId], references: [id])
  date        DateTime      @default(now())
  dueDate     DateTime?
  totalAmount Float         @default(0)
  paidAmount  Float         @default(0)
  paymentMethod PaymentMethod @default(ESPECES)
  status      SaleStatus    @default(EN_ATTENTE)
  pointsEarned Float        @default(0)
  pointsUsed   Float        @default(0)
  notes       String?

  // Trace de la validation en caisse : la vente est saisie (panier, client,
  // articles) sans toucher au stock ni au paiement, puis validée séparément
  // à la caisse — c'est cette validation qui décrémente le stock et encaisse.
  validatedAt   DateTime?
  validatedById String?
  validatedBy   User?     @relation("SaleValidatedBy", fields: [validatedById], references: [id])

  // Traçabilité de l'annulation : centralisée dans le module "Annulation de
  // facture", un motif est obligatoire et conservé pour l'audit.
  cancelReason   String?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelledBy    User?     @relation("SaleCancelledBy", fields: [cancelledById], references: [id])

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])

  items    SaleItem[]
  payments Payment[]

  @@unique([companyId, number])
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Une ligne de vente porte soit un produit, soit une prestation (jamais les
  // deux, jamais aucun) — vérifié côté application dans sales.ts.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  quantity  Float
  unitPrice Float
  subtotal  Float

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Payment {
  id          String      @id @default(cuid())
  type        PaymentType
  saleId      String?
  sale        Sale?       @relation(fields: [saleId], references: [id])
  purchaseId  String?
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id])
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  amount      Float
  method      PaymentMethod @default(ESPECES)
  // Pour un paiement en espèces avec appoint : montant physique reçu du
  // client et monnaie rendue, pour une traçabilité complète de la caisse
  // (amount reste toujours plafonné au montant dû, jamais gonflé par l'appoint).
  cashReceived Float?
  changeGiven  Float?
  date        DateTime    @default(now())
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  notes       String?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model Expense {
  id          String    @id @default(cuid())
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  category    String
  description String?
  amount      Float
  date        DateTime  @default(now())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}

model CashSession {
  id             String    @id @default(cuid())
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  openingAmount  Float     @default(0)
  closingAmount  Float?
  expectedAmount Float?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  notes          String?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
}
